        "foregroundImage": "./src/assets/LessoraLogo.png",
        "backgroundColor": "#F7F8FC"
      }
    },
    "web": {
      "favicon": "./src/assets/LessoraLogo.png"
    },
    "extra": {
      "eas": {
        "projectId": "276aada3-b5e4-445d-9f81-9108bd01b556"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {}
