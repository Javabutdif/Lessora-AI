      [
        "expo-splash-screen",
        {
          "image": "./src/assets/LessoraLogo.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F8FC"
        }
      ]
    ],
    "splash": {
      "image": "./src/assets/LessoraLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FC"
    },
    "android": {
