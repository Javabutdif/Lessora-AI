{
  "expo": {
    "name": "Lessora AI",
    "slug": "lessora-ai-client",
    "version": "1.0.0",
    "icon": "./src/assets/LessoraLogo.png",
    "userInterfaceStyle": "automatic",
    "sdkVersion": "54.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/276aada3-b5e4-445d-9f81-9108bd01b556"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
